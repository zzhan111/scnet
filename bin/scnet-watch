#!/usr/bin/env python3
# scnet-watch - SCNet Token Plan 月度 Credits 剩余额度。
#
# 通过 CDP (Chrome DevTools Protocol) 从正在运行的浏览器拿 scnet.cn 的
# 登录 cookie（浏览器自己解密，本脚本零解密依赖），再查询 SCNet 控制台 API：
#   GET https://www.scnet.cn/acx/charge/account/currentuser/tokenplan/list
# 输出单行 JSON：{"name":…, "remaining":…, "used":…, "total":…, "percent":…, "expire":…}
#
# 依赖：浏览器开着（CDP 端口），Python 3 + websocket-client。
# 只读：不写浏览器，不改网站。
import json
import os
import sys
import time
import urllib.request

try:
    import websocket
except ImportError:
    print(json.dumps({"error": "missing-websocket-client"}), flush=True)
    sys.exit(1)

CDP_PORTS = [19825, 9222]
PLAN_API = "https://www.scnet.cn/acx/charge/account/currentuser/tokenplan/list"


def cdp_websocket_url() -> str | None:
    """找一个开着 scnet.cn 页面的 tab 的调试地址。"""
    for port in CDP_PORTS:
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/json", timeout=2) as r:
                tabs = json.load(r)
            for t in tabs:
                if t.get("type") == "page" and "scnet.cn" in t.get("url", ""):
                    return t.get("webSocketDebuggerUrl")
        except Exception:
            continue
    return None


def get_cookies(url: str) -> dict[str, str]:
    """从 tab 拿全部 cookie，返回 {name: value}。"""
    # CDP 默认拒绝带 Origin 的非浏览器连接；suppress_origin 不发 Origin 头即握手成功。
    ws = websocket.create_connection(url, timeout=10, suppress_origin=True)
    try:
        ws.send(json.dumps({"id": 1, "method": "Network.getAllCookies"}))
        while True:
            msg = json.loads(ws.recv())
            if msg.get("id") != 1:
                continue
            out = {}
            for c in msg.get("result", {}).get("cookies", []):
                domain = c.get("domain", "")
                if domain in ("www.scnet.cn", ".scnet.cn"):
                    out[c["name"]] = c["value"]
            return out
    finally:
        ws.close()


def fetch(cookies: dict[str, str]) -> dict:
    header = "; ".join(f"{k}={v}" for k, v in cookies.items())
    req = urllib.request.Request(PLAN_API, headers={"Cookie": header})
    with urllib.request.urlopen(req, timeout=10) as r:
        data = json.load(r)
    if data.get("code") != "0":
        raise RuntimeError(f"API error: {data.get('msg')}")
    plans = [p for p in data.get("data", []) if p.get("status") == "enable"]
    active = max(plans, key=lambda p: (p["totalAmount"] - p["usedAmount"], p["maxExpireTime"] or ""))
    remaining = active["totalAmount"] - active["usedAmount"]
    return {
        "name": active.get("name", ""),
        "remaining": round(remaining, 1),
        "used": round(active["usedAmount"], 1),
        "total": round(active["totalAmount"], 1),
        "percent": round(remaining / active["totalAmount"] * 100, 1),
        "expire": active.get("maxExpireTime", ""), "ts": time.time(),
    }


def main() -> int:
    url = cdp_websocket_url()
    if not url:
        print(json.dumps({"error": "no-browser-tab"}))
        return 1
    try:
        cookies = get_cookies(url)
        if "Token" not in cookies:
            print(json.dumps({"error": "no-login"}))
            return 1
        snap = fetch(cookies)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        return 1
    print(json.dumps(snap, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
