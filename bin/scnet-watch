#!/usr/bin/env python3
# scnet-watch - SCNet Token Plan 月度 Credits 剩余额度。
#
# 经 CDP (Chrome DevTools Protocol) 从运行中的浏览器拿 scnet.cn 的登录 cookie
# （浏览器自己解密，本脚本零解密依赖），再查询 SCNet 控制台 API：
#   GET https://www.scnet.cn/acx/charge/account/currentuser/tokenplan/list
# 输出单行 JSON：{"name":…, "remaining":…, "used":…, "total":…, "percent":…, "expire":…, "ts":…}
#
# 只依赖 Python 3 标准库。CDP WebSocket 用一个最小的 stdlib 客户端：
# 握手时不发 Origin 头（发了会被 CDP 的来源校验 403 拒掉）。
import base64
import json
import os
import socket
import sys
import time
import urllib.request

CDP_PORTS = [19825, 9222]
PLAN_API = "https://www.scnet.cn/acx/charge/account/currentuser/tokenplan/list"


def cdp_websocket_url() -> str | None:
    """任意 page tab 的调试地址即可：cookie 是 profile 级的，
    在任何 tab 上 Network.getAllCookies 都返回全量（已实测）。"""
    for port in CDP_PORTS:
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/json", timeout=2) as r:
                tabs = json.load(r)
            for t in tabs:
                if t.get("type") == "page" and not t.get("url", "").startswith("devtools"):
                    return t.get("webSocketDebuggerUrl")
        except Exception:
            continue
    return None


# ponytail: 最小 CDP WebSocket 客户端，只够发一条命令收一条回复；
# 不处理分片/ping/close，连接用完即关。要长会话再换 websocket-client。
def ws_get_all_cookies(ws_url: str) -> dict[str, str]:
    u = urllib.parse.urlparse(ws_url)
    host, port = u.hostname, u.port or 80
    path = u.path + (("?" + u.query) if u.query else "")
    key = base64.b64encode(os.urandom(16)).decode()
    sock = socket.create_connection((host, port), timeout=10)
    try:
        # 不发 Origin：CDP 拒绝任何带 Origin 的非浏览器握手。
        sock.sendall((
            f"GET {path} HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\n"
            f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
        ).encode())
        buf = bytearray()
        while b"\r\n\r\n" not in buf:
            chunk = sock.recv(4096)
            if not chunk:
                raise RuntimeError("handshake EOF")
            buf += chunk
        head, buf = buf.split(b"\r\n\r\n", 1)
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise RuntimeError("handshake failed: " + head.split(b"\r\n", 1)[0].decode(errors="replace"))

        payload = json.dumps({"id": 1, "method": "Network.getAllCookies"}).encode()
        mask = os.urandom(4)
        frame = bytearray([0x81])
        n = len(payload)
        if n < 126:
            frame.append(0x80 | n)
        elif n < 65536:
            frame.append(0x80 | 126)
            frame += n.to_bytes(2, "big")
        else:
            frame.append(0x80 | 127)
            frame += n.to_bytes(8, "big")
        frame += mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        sock.sendall(bytes(frame))

        def need(k: int):
            nonlocal buf
            while len(buf) < k:
                chunk = sock.recv(65536)
                if not chunk:
                    raise RuntimeError("connection closed")
                buf += chunk

        while True:
            need(2)
            opcode, ln, off = buf[0] & 0x0F, buf[1] & 0x7F, 2
            if ln == 126:
                need(4)
                ln, off = int.from_bytes(buf[2:4], "big"), 4
            elif ln == 127:
                need(10)
                ln, off = int.from_bytes(buf[2:10], "big"), 10
            need(off + ln)
            body = buf[off:off + ln]
            del buf[:off + ln]
            if opcode == 0x8:  # close
                raise RuntimeError("cdp closed connection")
            if opcode != 0x1:  # 忽略 ping/pong/二进制
                continue
            msg = json.loads(body)
            if msg.get("id") != 1:
                continue
            if "error" in msg:
                raise RuntimeError("cdp error: " + msg["error"].get("message", ""))
            out = {}
            for c in msg.get("result", {}).get("cookies", []):
                if c.get("domain") in ("www.scnet.cn", ".scnet.cn"):
                    out[c["name"]] = c["value"]
            return out
    finally:
        sock.close()


def fetch(cookies: dict[str, str]) -> dict:
    header = "; ".join(f"{k}={v}" for k, v in cookies.items())
    req = urllib.request.Request(PLAN_API, headers={"Cookie": header})
    with urllib.request.urlopen(req, timeout=10) as r:
        data = json.load(r)
    if data.get("code") != "0":
        raise RuntimeError(f"API error: {data.get('msg')}")
    plans = [p for p in data.get("data", []) if p.get("status") == "enable"]
    active = max(plans, key=lambda p: (p["totalAmount"] - p["usedAmount"], p["maxExpireTime"] or ""))
    remaining = active["totalAmount"] - active["usedAmount"]
    return {
        "name": active.get("name", ""),
        "remaining": round(remaining, 1),
        "used": round(active["usedAmount"], 1),
        "total": round(active["totalAmount"], 1),
        "percent": round(remaining / active["totalAmount"] * 100, 1),
        "expire": active.get("maxExpireTime", ""),
        "ts": time.time(),
    }


def main() -> int:
    url = cdp_websocket_url()
    if not url:
        print(json.dumps({"error": "no-browser-tab"}))
        return 1
    try:
        cookies = ws_get_all_cookies(url)
        if "Token" not in cookies:
            print(json.dumps({"error": "no-login"}))
            return 1
        snap = fetch(cookies)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        return 1
    print(json.dumps(snap, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
